# Pixel baselines are committed for Linux only, because CI runs on Linux and
# Playwright stores one baseline per platform. A developer running the visual
# spec with VISUAL_LOCAL=1 generates their own platform's set here; those must
# never be committed. See apps/web/e2e/README.md.
apps/web/e2e/__screenshots__/*
!apps/web/e2e/__screenshots__/linux/

# Personal Claude Code settings; the shared launch.json is committed.
.claude/settings.local.json
