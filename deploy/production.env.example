# Image coordinates. Use one immutable Git commit SHA for all three images.
AWS_REGION=ap-east-2
ECR_REGISTRY=000000000000.dkr.ecr.ap-east-2.amazonaws.com
IMAGE_TAG=replace-with-full-git-sha
ACME_EMAIL=operations@example.com

# Public and internal origins.
NODE_ENV=production
APP_ORIGIN=https://portfolio.example
API_ORIGIN=http://api:3001
API_HOST=0.0.0.0
API_PORT=3001

# Store the real value as an encrypted AWS parameter/secret. RDS must remain
# private; require TLS in the client URL.
DATABASE_URL=postgresql://workflow_app:REPLACE_WITH_SECRET@workflow-production.000000000000.ap-east-2.rds.amazonaws.com:5432/workflow?sslmode=require

SESSION_COOKIE_NAME=workflow_session
SESSION_TTL_HOURS=12
LOGIN_LOCK_THRESHOLD=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Phone and browser push notifications. Generate the pair once with
# `pnpm push:vapid-keys`; changing it makes every device turn notifications on
# again. The private key goes to the worker only.
WEB_PUSH_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_SECRET
WEB_PUSH_SUBJECT=mailto:admin@portfolio.example

# Dedicated private S3 bucket. Access comes only from the EC2 instance role.
ATTACHMENT_STORAGE_DRIVER=s3
ATTACHMENT_S3_BUCKET=workflow-production-attachments-000000000000
ATTACHMENT_S3_PREFIX=attachments
ATTACHMENT_MAX_BYTES=95000000
ATTACHMENT_UPLOAD_CONCURRENCY=2
ATTACHMENT_DELETE_RETRY_BASE_MS=30000
ATTACHMENT_DELETE_RETRY_MAX_MS=1800000

WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_MS=300000
PUSH_DELIVERY_MAX_ATTEMPTS=5
PUSH_DELIVERY_RETRY_BASE_MS=30000
PUSH_DELIVERY_RETRY_MAX_MS=1800000
