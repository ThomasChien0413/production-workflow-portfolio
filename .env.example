NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgres://workflow:workflow_local@127.0.0.1:5432/workflow_demo
APP_ORIGIN=http://localhost:3000
# To try the app from a phone on the same network during development, set
# APP_ORIGIN to http://<this computer's address>:3000, open that address on
# both devices, and list the address here (hostnames only, comma-separated).
# ALLOWED_DEV_ORIGINS=192.168.1.20
SESSION_COOKIE_NAME=workflow_session
SESSION_TTL_HOURS=12
LOGIN_LOCK_THRESHOLD=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_MS=300000
PUSH_DELIVERY_MAX_ATTEMPTS=5
PUSH_DELIVERY_RETRY_BASE_MS=30000
PUSH_DELIVERY_RETRY_MAX_MS=1800000
# Phone and browser push: `pnpm push:vapid-keys` prints a pair for this file.
# Browsers allow push only on https:// or http://localhost.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@portfolio.example
ATTACHMENT_STORAGE_DRIVER=filesystem
ATTACHMENT_LOCAL_DIRECTORY=.local/attachments
ATTACHMENT_TEMP_DIRECTORY=.local/attachment-uploads
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_PREFIX=attachments
ATTACHMENT_MAX_BYTES=95000000
ATTACHMENT_UPLOAD_CONCURRENCY=2
ATTACHMENT_DELETE_RETRY_BASE_MS=30000
ATTACHMENT_DELETE_RETRY_MAX_MS=1800000
